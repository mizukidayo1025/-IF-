 {
  "description": "Restore explicitly identified working units when the observed capacity still matches the repair precondition.",
  "op": "facility_repair",
  "parameters_schema": {
   "additionalProperties": false,
   "properties": {
    "component_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
     "title": "Component Id",
     "type": "string"
    },
    "expected_working_units": {
     "minimum": 0,
     "title": "Expected Working Units",
     "type": "integer"
    },
    "facility_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
     "title": "Facility Id",
     "type": "string"
    },
    "restored_working_units": {
     "minimum": 0,
     "title": "Restored Working Units",
     "type": "integer"
    },
    "schema_version": {
     "const": 1,
     "default": 1,
     "title": "Schema Version",
     "type": "integer"
    },
    "source_ids": {
     "default": [],
     "items": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "type": "string"
     },
     "title": "Source Ids",
     "type": "array"
    }
   },
   "required": [
    "facility_id",
    "component_id",
    "expected_working_units",
    "restored_working_units"
   ],
   "title": "FacilityRepairParameters",
   "type": "object"
  },
  "required_policies": [
