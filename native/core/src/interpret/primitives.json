[
 {
  "description": "Generate synthetic household arrivals and admit them within zone capacity.",
  "op": "add_evacuees",
  "parameters_schema": {
   "$defs": {
    "DynamicArrivalPersonContext": {
     "additionalProperties": false,
     "description": "Optional per-member support request context for a typed arrival batch.",
     "properties": {
      "care_support_needs": {
       "default": [],
       "items": {
        "enum": [
         "medical_assessment",
         "medication_support",
         "caregiver_assistance",
         "privacy_accommodation",
         "mobility_assistance",
         "hygiene_support",
         "emotional_support",
         "language_access",
         "dependent_assistance"
        ],
        "type": "string"
       },
       "maxItems": 8,
       "title": "Care Support Needs",
       "type": "array"
      },
      "member_index": {
       "maximum": 999,
       "minimum": 0,
       "title": "Member Index",
       "type": "integer"
      }
     },
     "required": [
      "member_index"
     ],
     "title": "DynamicArrivalPersonContext",
     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "admission_zone_ids": {
     "default": [],
     "items": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
     },
     "maxItems": 16,
     "title": "Admission Zone Ids",
     "type": "array"
    },
    "approach_route_id": {
     "anyOf": [
      {
       "maxLength": 64,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Approach Route Id"
    },
    "count": {
     "exclusiveMinimum": 0,
     "maximum": 1000,
     "title": "Count",
     "type": "integer"
    },
    "household_size": {
     "default": 1,
     "maximum": 12,
     "minimum": 1,
     "title": "Household Size",
     "type": "integer"
    },
    "language": {
     "default": "ja",
     "maxLength": 64,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
     "title": "Language",
     "type": "string"
    },
    "mobility": {
     "default": "independent",
     "enum": [
      "independent",
      "assisted",
      "wheelchair"
     ],
     "title": "Mobility",
     "type": "string"
    },
    "person_context_overrides": {
     "default": [],
     "items": {
      "$ref": "#/$defs/DynamicArrivalPersonContext"
     },
     "maxItems": 1000,
     "title": "Person Context Overrides",
     "type": "array"
    }
   },
   "required": [
    "count"
   ],
   "title": "_EvacueeArrivalParameters",
   "type": "object"
  },
  "required_policies": [
   "population_dynamics_v1"
  ],
  "target_kinds": [
   "zone"
  ],
  "timed": false,
  "units": [
   "evacuee"
  ]
 },
