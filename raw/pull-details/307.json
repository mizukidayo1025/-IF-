  "title": "保存の残りを減らし、索引のプロセスを軽くする（手順 1 の A）",
  "user": {
    "login": "WaTeR-7",
    "id": 128142265,
    "node_id": "U_kgDOB6NLuQ",
    "avatar_url": "https://avatars.githubusercontent.com/u/128142265?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/WaTeR-7",
