  "title": "Checkpointの保存ごとにディスクを1回だけ数え、自分の書き込みを足して容量を確かめる（#237 の判断待ち）",
  "user": {
    "login": "WaTeR-7",
    "id": 128142265,
    "node_id": "U_kgDOB6NLuQ",
    "avatar_url": "https://avatars.githubusercontent.com/u/128142265?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/WaTeR-7",
    "html_url": "https://github.com/WaTeR-7",
    "followers_url": "https://api.github.com/users/WaTeR-7/followers",
    "following_url": "https://api.github.com/users/WaTeR-7/following{/other_user}",
    "gists_url": "https://api.github.com/users/WaTeR-7/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/WaTeR-7/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/WaTeR-7/subscriptions",
    "organizations_url": "https://api.github.com/users/WaTeR-7/orgs",
    "repos_url": "https://api.github.com/users/WaTeR-7/repos",
    "events_url": "https://api.github.com/users/WaTeR-7/events{/privacy}",
    "received_events_url": "https://api.github.com/users/WaTeR-7/received_events",
