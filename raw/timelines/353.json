        "pull_request": {
          "url": "https://api.github.com/repos/jphacks/tkb_2615/pulls/354",
          "html_url": "https://github.com/jphacks/tkb_2615/pull/354",
          "diff_url": "https://github.com/jphacks/tkb_2615/pull/354.diff",
