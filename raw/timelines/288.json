        "pull_request": {
          "url": "https://api.github.com/repos/jphacks/tkb_2615/pulls/290",
          "html_url": "https://github.com/jphacks/tkb_2615/pull/290",
          "diff_url": "https://github.com/jphacks/tkb_2615/pull/290.diff",
