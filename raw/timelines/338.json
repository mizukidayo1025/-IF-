          "url": "https://api.github.com/repos/jphacks/tkb_2615/pulls/339",
          "html_url": "https://github.com/jphacks/tkb_2615/pull/339",
          "diff_url": "https://github.com/jphacks/tkb_2615/pull/339.diff",
