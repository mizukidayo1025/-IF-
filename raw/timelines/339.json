          "url": "https://api.github.com/repos/jphacks/tkb_2615/pulls/340",
          "html_url": "https://github.com/jphacks/tkb_2615/pull/340",
          "diff_url": "https://github.com/jphacks/tkb_2615/pull/340.diff",
