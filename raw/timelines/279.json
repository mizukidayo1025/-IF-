        "pull_request": {
          "url": "https://api.github.com/repos/jphacks/tkb_2615/pulls/291",
          "html_url": "https://github.com/jphacks/tkb_2615/pull/291",
          "diff_url": "https://github.com/jphacks/tkb_2615/pull/291.diff",
          "patch_url": "https://github.com/jphacks/tkb_2615/pull/291.patch",
          "merged_at": "2026-10-30T08:11:38Z"
