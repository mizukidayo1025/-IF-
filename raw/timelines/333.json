        "pull_request": {
          "url": "https://api.github.com/repos/jphacks/tkb_2615/pulls/335",
          "html_url": "https://github.com/jphacks/tkb_2615/pull/335",
          "diff_url": "https://github.com/jphacks/tkb_2615/pull/335.diff",
