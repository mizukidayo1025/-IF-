        "pull_request": {
          "url": "https://api.github.com/repos/jphacks/tkb_2615/pulls/358",
          "html_url": "https://github.com/jphacks/tkb_2615/pull/358",
          "diff_url": "https://github.com/jphacks/tkb_2615/pull/358.diff",
          "patch_url": "https://github.com/jphacks/tkb_2615/pull/358.patch",
